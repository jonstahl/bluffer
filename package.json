{
  "name": "bluffer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/index.ts",
    "build:css": "tailwindcss -i frontend/input.css -o frontend/styles.css --minify",
    "watch:css": "tailwindcss -i frontend/input.css -o frontend/styles.css --watch",
    "build": "tsc && npm run build:css",
    "start": "node dist/index.js",
    "test": "playwright test"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^9.1.3",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.10.0",
    "fastify": "^5.8.5",
    "node-cron": "^4.2.1"
  },
  "devDependencies": {
    "@flydotio/dockerfile": "^0.7.4",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.10",
    "@types/node-cron": "^3.0.11",
    "dotenv-cli": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}

# Copy this to .env and fill in the values.
# Generate secrets with: openssl rand -hex 32

# App
PORT=3000
DB_PATH=./bluffer.db
APP_BASE_URL=http://localhost:3000
# Must be a canonical IANA timezone name (e.g. America/Los_Angeles, not America/Seattle)
OWNER_TIMEZONE=America/Chicago

# Secrets — generate fresh values, never reuse across environments
SESSION_SECRET=replace-with-openssl-rand-hex-48
TOKEN_ENCRYPTION_KEY=replace-with-openssl-rand-hex-32
BOOKMARKLET_TOKEN=replace-with-openssl-rand-hex-24

# bcrypt hash of your login password. IMPORTANT: escape every $ as \$ in this file,
# and wrap in double quotes, otherwise dotenv will expand $vars and corrupt the hash.
# Generate with: node -e "require('bcryptjs').hash('yourpassword',12).then(console.log)"
# Then paste result as: OWNER_PASSWORD_HASH="\$2a\$12\$..."
OWNER_PASSWORD_HASH=""

# LinkedIn OAuth app (https://developer.linkedin.com)
# Required for the Connect LinkedIn flow; everything else works without it.
# Register http://localhost:3000/auth/linkedin/callback as an OAuth redirect URL.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Litestream backups — leave blank to disable locally
LITESTREAM_S3_BUCKET=
LITESTREAM_S3_REGION=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
# LITESTREAM_S3_ENDPOINT=   # uncomment for non-AWS storage (Backblaze, Tigris, etc.)
